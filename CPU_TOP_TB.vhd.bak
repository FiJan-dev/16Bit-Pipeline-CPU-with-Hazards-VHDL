library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity CPU_TOP_tb is
end entity;

architecture sim of CPU_TOP_tb is
    signal clk : std_logic := '0';
    signal rst : std_logic := '1';

    constant CLK_PERIOD : time := 10 ns;
begin

    -- Instancia do seu topo
    DUT: entity work.CPUTOP
        port map(
            clk => clk,
            rst => rst
        );

    -- Gera clock
    process
    begin
        while true loop
            clk <= '0';
            wait for CLK_PERIOD/2;
            clk <= '1';
            wait for CLK_PERIOD/2;
        end loop;
    end process;

    -- Reset inicial
    process
    begin
        rst <= '1';
        wait for 30 ns;
        rst <= '0';
        wait;
    end process;

end architecture;
