LIBRARY IEEE;
USE IEEE.std_logic_1164.ALL;
USE IEEE.numeric_std.ALL;
USE WORK.CPU_package.ALL;

ENTITY MEM_STAGE is
    PORT(
        CLOCK : IN STD_LOGIC;
        RESET : IN STD_LOGIC;
        DATA_IN : IN DATA_REG_EX_MEM;
        DATA_OUT: OUT DATA_REG_MEM_WB
    );
END MEM_STAGE;

ARCHITECTURE COMPORTAMENTO OF MEM_STAGE is
    SIGNAL MEM_WRITE, MEM_READ : STD_LOGIC;
    SIGNAL ADDRESS, WRITE_DATA, READ_DATA : DATA_T; --EM TEORIA SEPARAR O SIGNAL ADDRESS PARA OUTRO TIPO
begin
    MEM_READ <= DATA_IN(39);
    MEM_WRITE <= DATA_IN(38);
    ADDRESS <= DATA_IN(35 DOWNTO 20);
    WRITE_DATA <= DATA_IN(19 DOWNTO 4);

    MEM: MEMORY_DATA PORT MAP(CLOCK, RESET, MEM_WRITE, MEM_READ, ADDRESS, WRITE_DATA, READ_DATA);

    DATA_OUT <= DATA_IN(37 DOWNTO 36) & READ_DATA & ADDRESS & DATA_IN(3 DOWNTO 0);

END COMPORTAMENTO;