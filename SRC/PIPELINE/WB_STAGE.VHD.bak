LIBRARY IEEE;
USE IEEE.std_logic_1164.ALL;
USE IEEE.numeric_std.ALL;

ENTITY WB_STAGE IS
    PORT(
        CLOCK : IN STD_LOGIC;
        RESET : IN STD_LOGIC;
        DATA_IN : IN DATA_REG_MEM_WB;
        REGWRITE : OUT STD_LOGIC;
        DATA_WB_ID : OUT DATA_T;
        REG_DST: OUT STD_LOGIC_VECTOR(3 DOWNTO 0)
    );
END WB_STAGE;

ARCHITECTURE COMPORTAMENTO OF WB_STAGE IS
    SIGNAL MUX_MEM_2_REG : STD_LOGIC;
    SIGNAL MEMORY_DATA : DATA_T;
    SIGNAL ULA_RESULT : DATA_T;
BEGIN
    MUX_MEM_2_REG <= DATA_IN(37);
    REGWRITE <= DATA_IN(36);
    MEMORY_DATA <= DATA_IN(35 DOWNTO 20);
    ULA_RESULT <= DATA_IN(19 DOWNTO 4);
    REG_DST <= DATA_IN(3 DOWNTO 0);


    PROCESS(CLOCK, RESET, MUX_MEM_2_REG)
    BEGIN
        IF MUX_MEM_2_REG = '0' THEN
            DATA_WB_ID <= MEMORY_DATA;
        ELSE
            DATA_WB_ID <= ULA_RESULT;
        END IF;
    END PROCESS;
    
END COMPORTAMENTO;